# Copy to .env.local for local work. Add the same values in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Optional until your domain is verified in Resend; the default below works for testing.
CONTACT_FROM_EMAIL=Studio Site <onboarding@resend.dev>
# Add once your domain is connected, e.g. https://yourdomain.com
NEXT_PUBLIC_SITE_URL=
